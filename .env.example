#  ⚠️  ESTE PROJETO NÃO LÊ ARQUIVOS .env.  ⚠️
#
#  O backend é PHP puro e carrega a configuração de constantes definidas em
#  public/api/env.php. Este arquivo existe só como espelho documental, porque
#  é o primeiro lugar onde as pessoas procuram.
#
#  Para configurar de verdade:
#
#      cp public/api/env.example.php public/api/env.php
#
#  e edite public/api/env.php — lá cada variável está documentada em detalhe.
#  Nenhuma das linhas abaixo tem efeito se você criar um .env.
#
# ── Referência das variáveis reais (nomes conforme usados no código) ─────────

# URL pública da instalação, sem barra final.
APP_URL=

# Painel administrativo (usuário único; ADMIN_PASS aceita texto ou hash bcrypt).
ADMIN_USER=
ADMIN_PASS=

# true expõe mensagens de erro internas na API. false em produção.
APP_DEBUG=

# Validade do token de sessão das pessoas atletas, em segundos.
SESSION_DURATION=

# Resend (e-mail transacional). O valor literal re_COLOQUE_SUA_CHAVE_AQUI liga
# o modo dev, que devolve códigos de login/magic link no próprio JSON.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=

# Mercado Pago. Use as SUAS credenciais, começando pelas de teste.
# Sem MP_WEBHOOK_SECRET o webhook aceita requisições não assinadas.
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Backdoor de desenvolvimento: quita pagamentos sem cobrar. Sempre false online.
PAGAMENTO_MOCK=

# Prazo de edição dos serviços pela pessoa atleta. Vazio = sem prazo.
ALIMENTACAO_EDITAVEL_ATE=
ALOJAMENTO_EDITAVEL_ATE=
